{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "chrome", "vite/client"],
    "baseUrl": ".",
    "paths": {"@gamma/engine": ["packages/engine/src/index.ts"]}
  },
  "include": ["apps", "packages", "tests", "scripts"]
}
