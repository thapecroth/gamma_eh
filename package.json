{
  "name": "gamma-eh",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vp dev --config apps/web/vite.config.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint apps packages scripts tests",
    "test": "vp test run --dir tests",
    "test:release": "node --test --test-isolation=none tests/release.node.mjs tests/ga-readiness.node.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:editing": "python3 scripts/agent-supervisor.py node scripts/verify-editing.mjs",
    "benchmark:inference": "node scripts/benchmark-inference.mjs",
    "analyze:inference": "node scripts/analyze-inference.mjs",
    "test:inference-analysis": "python3 scripts/agent-supervisor.py node scripts/verify-inference-analysis.mjs",
    "test:playground": "node scripts/verify-playground.mjs",
    "data:synthetic": "python3 training/synthetic_challenge.py",
    "evaluate:synthetic": "npm run data:synthetic && node scripts/evaluate-synthetic.mjs",
    "test:agents": "python3 scripts/agent-supervisor.py node --test --test-isolation=none tests/agent-harness.node.mjs",
    "test:extension": "python3 scripts/agent-supervisor.py node scripts/extension-driver.mjs",
    "agent:e2e": "python3 scripts/agent-supervisor.py node scripts/agent-harness.mjs e2e",
    "agent:loop": "python3 scripts/agent-supervisor.py node scripts/agent-harness.mjs loop",
    "release:package": "node scripts/package-release.mjs",
    "release:readiness": "node scripts/ga-readiness.mjs",
    "webstore:artwork": "node scripts/webstore-assets.mjs artwork",
    "webstore:screenshots": "node scripts/webstore-assets.mjs screenshots",
    "webstore:submit": "node scripts/webstore-submit.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:release && npm run test:agents && npm run build"
  },
  "dependencies": {
    "@jax-js/jax": "0.1.25",
    "@jax-js/onnx": "0.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/chrome": "^0.1.34",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "0.28.1",
    "marked": "18.0.14",
    "typescript": "^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "5.0.1",
    "onnx-buf": "1.20.0-1",
    "@bufbuild/protobuf": "2.16.0"
  }
}
