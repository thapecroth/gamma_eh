{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thapecroth/gamma_eh/blob/main/docs/ga-readiness.schema.json",
  "title": "Gamma EH GA readiness record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "owner", "approved_by", "approved_at", "scope", "policy", "release", "gates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "status": {"enum": ["pending", "blocked", "ready"]},
    "owner": {"type": "string", "minLength": 1},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["surfaces", "platforms", "local_ai"],
      "properties": {
        "surfaces": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["chrome", "web"]}},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["windows", "macos", "linux"]}},
        "local_ai": {"enum": ["experimental", "ga"]}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["approved", "max_evidence_age_days", "min_edit_precision", "max_clean_changed_rate", "min_predicted_edits"],
      "properties": {
        "approved": {"type": "boolean"},
        "max_evidence_age_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "min_edit_precision": {"type": "number", "minimum": 0.95, "maximum": 1},
        "max_clean_changed_rate": {"type": "number", "minimum": 0, "maximum": 0.02},
        "min_predicted_edits": {"type": "integer", "minimum": 25}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["tag", "source_commit", "source_sha256", "model_manifest_sha256", "assets"],
      "properties": {
        "tag": {"type": ["string", "null"], "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "source_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "source_sha256": {"$ref": "#/$defs/hash"},
        "model_manifest_sha256": {"$ref": "#/$defs/hash"},
        "assets": {"$ref": "#/$defs/assets"}
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["quality", "editing-safety", "platforms", "distribution", "privacy", "accessibility", "pilot", "operations"],
      "properties": {
        "quality": {"$ref": "#/$defs/gate"}, "editing-safety": {"$ref": "#/$defs/gate"},
        "platforms": {"$ref": "#/$defs/gate"}, "distribution": {"$ref": "#/$defs/gate"},
        "privacy": {"$ref": "#/$defs/gate"}, "accessibility": {"$ref": "#/$defs/gate"},
        "pilot": {"$ref": "#/$defs/gate"}, "operations": {"$ref": "#/$defs/gate"}
      }
    }
  },
  "$defs": {
    "hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "assets": {
      "type": "object", "additionalProperties": false, "required": ["chrome", "firefox", "web"],
      "properties": {"chrome": {"$ref": "#/$defs/hash"}, "firefox": {"$ref": "#/$defs/hash"}, "web": {"$ref": "#/$defs/hash"}}
    },
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["status", "owner", "evidence", "sha256"],
      "properties": {
        "status": {"enum": ["pending", "blocked", "passed"]}, "owner": {"type": "string", "minLength": 1},
        "evidence": {"type": ["string", "null"], "pattern": "^docs/ga-evidence/[a-zA-Z0-9_-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
